pkgname=obs-plugin-flood-tuber-git
pkgver=1.3.0.r0.g0000000
pkgrel=1
pkgdesc="PNGTuber plugin for OBS Studio with audio threshold and animated image support (VCS package)"
arch=('x86_64' 'aarch64')
url="https://github.com/justflood/flood-tuber"
license=('GPL-2.0-or-later')
depends=('obs-studio' 'libwebp')
makedepends=('cmake' 'ninja' 'git' 'simde')
provides=('obs-plugin-flood-tuber')
conflicts=('obs-plugin-flood-tuber')
_branch=test-arch-linux
source=("git+https://github.com/Poste2Travail/flood-tuber.git#branch=$_branch")
sha256sums=('SKIP')

pkgver() {
  cd "flood-tuber"
  # Fallback is explicit: a pipeline's exit status is sed's, so `git describe ... || printf`
  # never reached the fallback when the repo has no tags (as on this branch).
  if desc=$(git describe --long --tags --abbrev=7 2>/dev/null); then
    printf '%s' "$desc" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cmake -B build -S "flood-tuber" \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
