#Maintainer: Firstof9 <https://github.com/firstof9>
pkgname=obs-plugin-flood-tuber
# Upstream pre-release tag v1.3.0-beta1 (pacman pkgver cannot contain '-', so '_' is used)
_tag=v1.3.0-beta1
pkgver=1.3.0_beta1
pkgrel=1
pkgdesc="PNGTuber plugin for OBS Studio with audio threshold and animated image support"
arch=('x86_64' 'aarch64')
url="https://github.com/justflood/flood-tuber"
license=('GPL-2.0-or-later')
depends=('obs-studio' 'libwebp')
makedepends=('cmake' 'ninja' 'git' 'simde')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
sha256sums=('SKIP') # TODO: replace with the sha256 of the $_tag tarball once it can be downloaded

build() {
  cmake -B build -S "flood-tuber-${_tag#v}" \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
